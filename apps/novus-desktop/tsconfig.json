{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "rootDir": "../..",
    "outDir": "dist",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src", "forge.env.d.ts", "forge.config.ts", "vite.*.ts", "vite.*.mts"],
  "exclude": ["node_modules", "dist", ".vite", "out"]
}
