{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "exclude": ["dist", "out", "node_modules", "src/renderer/dist"]
}
